# Copy this file to ".env" and fill in your own values. ".env" is git-ignored: never commit it.
# Only the provider you actually use needs a key.

# DeepSeek (OpenAI-compatible). Create a key on the DeepSeek platform, API keys page.
DEEPSEEK_API_KEY=
# Optional. Default is deepseek-flash. If the API rejects the name, check https://api-docs.deepseek.com/
# DEEPSEEK_MODEL=deepseek-v4-pro

# Other providers (optional)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OLLAMA_URL=http://localhost:11434

# Layer 3 judge (firewall/judge.py). Provider: groq | deepseek | gemini | ollama | local | anthropic | openai | none
# FIREWALL_JUDGE_PROVIDER=deepseek   (or gemini). The judge is called only when a security admin ticks it in the console.
# GEMINI_API_KEY=       (free key from https://aistudio.google.com)
# GEMINI_MODEL=gemini-2.5-flash
# FIREWALL_JUDGE_DAILY_CALLS=60
# FIREWALL_AUTO_JUDGE=1  automatically review semantic alerts before the Power Agent; failures go to REVIEW
# Dedicated Groq Judge. Fill its key, then set FIREWALL_JUDGE_PROVIDER=groq and restart the API.
# It cannot reuse any Agent GROQ_API_KEY/GROQ_API_KEY_2/... or the Agent model.
GROQ_JUDGE_API_KEY=
GROQ_JUDGE_MODEL=openai/gpt-oss-20b
# Separate keys in the same Groq organization still share applicable organization limits.
# FIREWALL_DEMO_MODE=1       lets a security admin switch layers off per request in the console (testing aid)

# Agent (agent/, api/routes/agent.py, evaluation/eval_agent.py). Free tiers only; never put a paid key here.
# AGENT_PROVIDER: scripted (default, no network) | groq | gemini | local
# AGENT_PROVIDER=scripted
# AGENT_MODEL=openai/gpt-oss-120b        (Groq default; the plan's llama-3.3-70b-versatile was rejected by the account on 2026-11-02. List: GET https://api.groq.com/openai/v1/models)
GROQ_API_KEY=
# Optional fallback keys, tried in numeric order when a key reaches a long rate limit.
# Empty or duplicate keys are ignored. Keys in the same Groq organization share its quota.
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
# GEMINI_API_KEY= is shared with the Layer 3 judge above (Gemini's OpenAI-compatible endpoint, model gemini-2.5-flash)
# AGENT_MAX_STEPS=6        tool-calling steps per customer message
# AGENT_MAX_CALLS=300      hard cap on LLM requests per process (429 retries count); a run stops cleanly when it is reached
# AGENT_ALLOW_FIREWALL_OFF=1  local demo only: permit off/detection comparisons (run_demo.bat sets it)
# FIREWALL_INCIDENTS_FILE=data/incidents.json  optional separate incident log for isolated demo/test runs
